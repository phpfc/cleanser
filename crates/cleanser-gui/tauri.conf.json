{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cleanser",
  "version": "0.5.0",
  "identifier": "app.cleanser-claws.cleanser",
  "build": {
    "beforeDevCommand": {
      "cwd": "ui",
      "script": "npm run dev"
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "cwd": "ui",
      "script": "npm run build"
    },
    "frontendDist": "ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cleanser",
        "width": 900,
        "height": 700,
        "minWidth": 600,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
